# Copy this file to .env.local (git-ignored) and fill in the real values. These are the SAME
# Supabase project values as the backend's SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY.
#
# Vite only exposes variables prefixed with VITE_ to browser code — and everything here SHIPS IN THE
# BUNDLE, readable by anyone who opens devtools. That's fine here: the publishable (anon) key is
# designed to be public; Row-Level Security and the backend's JWT validation are the real gate.
# NEVER put a secret (service_role key, DB password) in a VITE_ variable.

VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_[YOUR-KEY]"

# Optional. Where the backend lives. Leave unset locally (defaults to the dev server at
# http://localhost:3000/api). On a deployed build, set this to the live API's URL — otherwise the
# deployed client tries to call localhost and every request fails.
# VITE_API_URL="https://your-api.example.com/api"
