                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));\r",
                  "\r",
                  "const json = pm.response.json();\r",
                  "pm.environment.set(\"token\", json.access_token);\r",
                  "pm.environment.set(\"userId\", json.user.id);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabaseKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"test@example.com\",\r\n    \"password\": \"test12345\"\r\n}",
