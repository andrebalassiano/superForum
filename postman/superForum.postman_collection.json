      "item": [
        {
          "name": "Supabase: Sign-up",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"sign-up ok or user already exists\", () =>\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 422]));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "apikey",
                "value": "{{supabaseKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\": \"test@example.com\",\r\n    \"password\": \"test12345\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{supabaseUrl}}/auth/v1/signup",
              "host": [
                "{{supabaseUrl}}"
              ],
              "path": [
                "auth",
                "v1",
                "signup"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Supabase: Sign-in",
          "event": [
            {
              "listen": "test",
              "script": {
