{
  "name": "superforum",
  "version": "1.0.0",
  "description": "A Reddit-style forum REST API built with TypeScript, Express 5, Prisma 7, and Supabase auth.",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:realtoken": "vitest run --config vitest.realtoken.config.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/server.ts",
    "dev:watch": "tsx watch src/server.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrebalassiano/superForum.git"
  },
  "keywords": [
    "rest-api",
    "express",
    "typescript",
    "prisma",
    "postgresql",
    "supabase",
    "forum"
  ],
  "author": "Andre Balassiano",
  "contributors": [
    "Luiz Tatemoto"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/andrebalassiano/superForum/issues"
  },
  "homepage": "https://github.com/andrebalassiano/superForum#readme",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.4.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "prisma": "^7.4.2",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.4.2",
    "@supabase/supabase-js": "^2.106.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "pg": "^8.21.0"
  }
}
