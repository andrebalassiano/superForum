# Committed template for the test environment. Copy to .env.test to run the suite locally.
#
#   PowerShell:  Copy-Item .env.test.example .env.test
#
# The default value matches docker-compose.test.yml (port 5433, db superforum_test).
# Supabase vars are intentionally absent: the auth boundary is mocked in tests
# (test/setup/each-setup.ts), so no real Supabase project or tokens are needed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/superforum_test?schema=public"
