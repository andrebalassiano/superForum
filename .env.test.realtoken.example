# Real-token auth-contract lane — enables `npm run test:realtoken`.
# Copy to .env.test.realtoken (git-ignored) and fill in the Supabase values.
# WITHOUT this file the suite SKIPS (it never fails a run for lacking creds).
#
#   PowerShell:  Copy-Item .env.test.realtoken.example .env.test.realtoken
#
# Unlike the mocked suite, this lane hits a REAL Supabase project: it signs a real test user in,
# gets a real JWT, and drives it through requireAuth. It still uses the throwaway test DB (same
# container as the mocked suite) — never point DATABASE_URL at production.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/superforum_test?schema=public"
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<publishable / anon key>"
SUPABASE_TEST_EMAIL="test@example.com"
SUPABASE_TEST_PASSWORD="test12345"
