# Copy this file to .env and fill in the real values from the Supabase dashboard.
# .env is gitignored — never commit it.

# Pooled Postgres connection (port 6543 with ?pgbouncer=true, OR port 5432 without).
# Found at: Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Direct (non-pooled) Postgres connection — Prisma uses this for migrations.
# Same place in the dashboard; pick the "Direct connection" variant.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Supabase project URL. Found at: Project Settings -> API -> Project URL
SUPABASE_URL="https://[PROJECT-REF].supabase.co"

# Publishable (anon) key — safe to embed in client code by design, but kept here for clarity.
# Found at: Project Settings -> API -> Project API keys -> anon / publishable
SUPABASE_PUBLISHABLE_KEY="sb_publishable_[YOUR-KEY]"

# Optional. Comma-separated list of browser origins allowed via CORS.
# Defaults to http://localhost:5173 (the Vite dev server) when unset.
CORS_ORIGIN="http://localhost:5173"

# Optional. Write-route rate limiting (reads are never limited). A client that exceeds
# RATE_LIMIT_MAX write requests per RATE_LIMIT_WINDOW_MS (per IP) gets a 429.
# Defaults: 100 requests per 15 minutes. Disabled entirely when NODE_ENV=test.
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"